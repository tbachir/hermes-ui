# hermes-ui itself is backend/auth agnostic. The consuming app owns identity.
# These are the only Hermes runtime variables required by the registry blocks.

HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Optional application-side authorization seam used by hermes-access.
HERMES_UI_ALLOWED_ROLES=admin
HERMES_UI_ALLOWED_USER_IDS=
