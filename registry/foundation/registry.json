{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hermes-ui-foundation",
  "homepage": "https://github.com/tbachir/hermes-ui",
  "items": [
    {
      "name": "supabase-next",
      "type": "registry:block",
      "title": "Supabase Next.js Foundation",
      "description": "Supabase SSR clients and Next.js 16 proxy using publishable keys and getClaims-compatible auth refresh.",
      "author": "Tarek Bachir",
      "dependencies": [
        "@supabase/ssr@0.12.4",
        "@supabase/supabase-js@2.112.2"
      ],
      "envVars": {
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": ""
      },
      "files": [
        {
          "path": "supabase-next/client.ts",
          "type": "registry:lib",
          "target": "@lib/supabase/client.ts"
        },
        {
          "path": "supabase-next/server.ts",
          "type": "registry:lib",
          "target": "@lib/supabase/server.ts"
        },
        {
          "path": "supabase-next/proxy-lib.ts",
          "type": "registry:lib",
          "target": "@lib/supabase/proxy.ts"
        },
        {
          "path": "supabase-next/proxy.ts",
          "type": "registry:file",
          "target": "~/proxy.ts"
        }
      ],
      "categories": [
        "supabase",
        "auth",
        "foundation",
        "nextjs"
      ],
      "docs": "Next.js 16 uses proxy.ts. Set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. Do not use a Supabase secret/service-role key in browser code."
    },
    {
      "name": "hermes-server",
      "type": "registry:lib",
      "title": "Hermes Server Foundation",
      "description": "Server-only @burner-io/hermes management and API Server clients with environment validation.",
      "author": "Tarek Bachir",
      "dependencies": [
        "@burner-io/hermes@^0.5.0",
        "server-only"
      ],
      "envVars": {
        "HERMES_DASHBOARD_URL": "http://127.0.0.1:9119",
        "HERMES_SESSION_TOKEN": "",
        "HERMES_BEARER_TOKEN": "",
        "HERMES_API_SERVER_URL": "http://127.0.0.1:8642",
        "HERMES_API_SERVER_KEY": "",
        "HERMES_DEFAULT_PROFILE": ""
      },
      "files": [
        {
          "path": "hermes-server/env.ts",
          "type": "registry:lib",
          "target": "@lib/hermes/env.ts"
        },
        {
          "path": "hermes-server/server.ts",
          "type": "registry:lib",
          "target": "@lib/hermes/server.ts"
        },
        {
          "path": "hermes-server/errors.ts",
          "type": "registry:lib",
          "target": "@lib/hermes/errors.ts"
        }
      ],
      "categories": [
        "hermes",
        "foundation",
        "server",
        "nextjs"
      ],
      "docs": "Hermes credentials are server-only. Never rename them to NEXT_PUBLIC_*."
    },
    {
      "name": "hermes-access",
      "type": "registry:lib",
      "title": "Hermes Supabase Access Guard",
      "description": "Protect Hermes route handlers with verified Supabase JWT claims and an explicit user allow-list.",
      "author": "Tarek Bachir",
      "registryDependencies": [
        "tbachir/hermes-ui/supabase-next",
        "tbachir/hermes-ui/hermes-server"
      ],
      "envVars": {
        "HERMES_UI_ALLOWED_USER_IDS": "",
        "HERMES_UI_GIT_ROOTS": ""
      },
      "files": [
        {
          "path": "hermes-access/access.ts",
          "type": "registry:lib",
          "target": "@lib/hermes/access.ts"
        }
      ],
      "categories": [
        "hermes",
        "supabase",
        "auth",
        "security"
      ],
      "docs": "Set HERMES_UI_ALLOWED_USER_IDS to a comma-separated list of Supabase auth user IDs. Use * only if every authenticated app user may control Hermes. HERMES_UI_GIT_ROOTS is an optional comma-separated allow-list for remote Hermes Git paths."
    },
