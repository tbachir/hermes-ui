{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hermes-ui-blocks",
  "homepage": "https://github.com/tbachir/hermes-ui",
  "items": [
    {
      "name": "hermes-stack",
      "type": "registry:block",
      "title": "Hermes API Server Stack",
      "description": "Opinionated server-only Hermes connection, bounded BFF, TanStack Query facade and supported UI blocks.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-server",
        "tbachir/hermes-ui/hermes-access",
        "tbachir/hermes-ui/hermes-api",
        "tbachir/hermes-ui/hermes-query",
        "tbachir/hermes-ui/hermes-status-card",
        "tbachir/hermes-ui/hermes-run-console",
        "tbachir/hermes-ui/hermes-session-list",
        "tbachir/hermes-ui/hermes-capabilities-center",
        "tbachir/hermes-ui/hermes-models-center",
        "tbachir/hermes-ui/hermes-system-center"
      ],
      "files": [],
      "categories": ["hermes", "api-server", "starter", "nextjs"],
      "docs": "The consuming app owns auth/backend policy. Provide @/lib/app-user, set HERMES_URL and HERMES_API_KEY server-side, and keep Hermes unreachable from the browser/public network."
    },
    {
      "name": "hermes-capabilities-center",
      "type": "registry:block",
      "title": "Hermes Capabilities Center",
      "description": "Advertised API capabilities plus read-only skills and toolsets from the API Server.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "card",
        "skeleton"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-capabilities-center/hermes-capabilities-center.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-capabilities-center.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "capabilities", "skills", "toolsets"]
    },
    {
      "name": "hermes-models-center",
      "type": "registry:block",
      "title": "Hermes Models Center",
      "description": "OpenAI-compatible model list and rich Hermes model options from the API Server.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "button",
        "card",
        "skeleton"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-models-center/hermes-models-center.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-models-center.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "models"]
    },
    {
      "name": "hermes-system-center",
      "type": "registry:block",
      "title": "Hermes System Center",
      "description": "Detailed API Server readiness and machine-readable contract inspection.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "card",
        "skeleton"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-system-center/hermes-system-center.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-system-center.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "health", "contract"]
    }
  ]
}
