{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "hermes-ui-components",
  "homepage": "https://github.com/tbachir/hermes-ui",
  "items": [
    {
      "name": "hermes-status-card",
      "type": "registry:component",
      "title": "Hermes API Server Status",
      "description": "Detailed health + advertised API capabilities for the private Hermes API Server.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "button",
        "card",
        "skeleton"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-status-card/hermes-status-card.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-status-card.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "status"]
    },
    {
      "name": "hermes-run-console",
      "type": "registry:component",
      "title": "Hermes Run Console",
      "description": "Interactive native Runs console with session continuity, approvals and stop controls.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "button",
        "card",
        "separator",
        "textarea",
        "https://elements.ai-sdk.dev/api/registry/message.json"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-run-console/hermes-run-console.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-run-console.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "runs", "ai"]
    },
    {
      "name": "hermes-session-list",
      "type": "registry:component",
      "title": "Hermes Session List",
      "description": "Recent API Server sessions with model, tokens and activity metadata.",
      "registryDependencies": [
        "tbachir/hermes-ui/hermes-query",
        "badge",
        "button",
        "card",
        "skeleton",
        "table"
      ],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "hermes-session-list/hermes-session-list.tsx",
          "type": "registry:component",
          "target": "@components/hermes/hermes-session-list.tsx"
        }
      ],
      "categories": ["hermes", "api-server", "sessions"]
    }
  ]
}
